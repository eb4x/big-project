---
apiVersion: v1
kind: Pod
metadata:
  name: quay
spec:
  hostNetwork: {{ quay_use_host_network | default(false) | lower }}
  containers:
  - name: postgres
    image: "docker.io/postgres:15"
    env:
    - { name: POSTGRES_USER, value: {{ database.user }} }
    - { name: POSTGRES_PASSWORD, value: {{ database.password }} }
    - { name: POSTGRES_DB, value: quay }
    volumeMounts:
    - { name: pg-storage, mountPath: "/var/lib/postgresql/data:Z" }
    - { name: pg-extension-trgm, mountPath: "/docker-entrypoint-initdb.d/pg_trgm.sql:Z" }

  - name: redis
    image: "docker.io/redis:6"
    args:
    - --requirepass {{ quay_redis_password }}
{% if not quay_use_host_network | default(false) %}
    ports:
    - { hostPort: 6379, containerPort: 6379, protocol: TCP }
{% endif %}

  - name: app
    image: "{{ quay_repository | default('quay.io/projectquay/quay') }}:{{ quay_tag | default('3.14.0') }}"
    #securityContext:
    #  sysctls:
    #  - { name: net.core.somaxconn, value: "4096" }
    volumeMounts:
    - { name: quay-config, mountPath: "/conf/stack:Z" }
{% if not quay_enable_s3 | default(false) %}
    - { name: quay-storage, mountPath: "/datastorage:Z" }
{% endif %}
{% if not quay_use_host_network | default(false) %}
    ports:
    - { hostPort: 8080, containerPort: 8080, protocol: TCP }
    - { hostPort: 9091, containerPort: 9091, protocol: TCP }
{% endif %}

  volumes:
  - name: pg-storage
    persistentVolumeClaim:
      claimName: quay-db-pvc
  - name: pg-extension-trgm
    hostPath:
      type: File
      path: {{ home_dir }}/sql/pg-extension-trgm.sql
  - name: quay-config
    hostPath:
      type: Directory
      path: {{ home_dir }}/quay-config
{% if not quay_enable_s3 | default(false) %}
  - name: quay-storage
    persistentVolumeClaim:
      claimName: quay-storage-pvc
{% endif %}

  hostAliases:
  - ip: 127.0.0.1
    hostnames:
    - quay
    - redis
  - ip: 192.168.141.3
    hostnames:
    - clair.judy.slips.pl
